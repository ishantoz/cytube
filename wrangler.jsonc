{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "cytube-api",
	"account_id": "d358e3cf2b86f90bc2bbe019395fc622",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"compatibility_date": "2026-03-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"assets": {
		"directory": "./dist",
		"binding": "STATIC"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "cytube",
			"database_id": "d9473444-b1f5-4d8e-b09e-752cedc7fe85",
			"migrations_dir": "prisma/migrations/d1"
		}
	],
	"r2_buckets": [
		{
			"binding": "ASSETS",
			"bucket_name": "cytube-assets"
		}
	],
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "303b526ba87f4184a639f65f21d89b47",
			"preview_id": "31ba440be13947a88ffbdc42a2607636"
		},
		{
			"binding": "KV",
			"id": "0a710140e69749efb81a5cec54fb3962",
			"preview_id": "88b096fc15204115bc21e0f809204b96"
		}
	],
	"env": {
		"dev": {
			"name": "cytube-dev",
			"routes": [
				{
					"pattern": "cytube-dev.ishanto.com",
					"custom_domain": true
				}
			],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "cytube-dev",
					"database_id": "723576e8-78ea-4edd-889e-5b9fba95af0c",
					"migrations_dir": "prisma/migrations/d1"
				}
			],
			"r2_buckets": [
				{
					"binding": "ASSETS",
					"bucket_name": "cytube-dev-assets"
				}
			],
			"kv_namespaces": [
				{
					"binding": "SESSION",
					"id": "e3a72ac382164220a9693bc8dc8c5d6c"
				},
				{
					"binding": "KV",
					"id": "25f65c9ddd2448e69f02c6de195b3228"
				}
			]
		},
		"production": {
			"name": "cytube-api",
			"routes": [
				{
					"pattern": "cytube.ishanto.com",
					"custom_domain": true
				}
			],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "cytube",
					"database_id": "d9473444-b1f5-4d8e-b09e-752cedc7fe85",
					"migrations_dir": "prisma/migrations/d1"
				}
			],
			"r2_buckets": [
				{
					"binding": "ASSETS",
					"bucket_name": "cytube-assets"
				}
			],
			"kv_namespaces": [
				{
					"binding": "SESSION",
					"id": "7171a12b351b46f09e1dc1ccb2e2f3d2"
				},
				{
					"binding": "KV",
					"id": "8c52d3568b804b0697c9f19436acc7c1"
				}
			]
		}
	}
}
