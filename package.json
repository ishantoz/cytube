{
  "name": "cytube",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:app": "astro build",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate:remote": "wrangler d1 migrations apply cytube --remote --env production",
    "db:migrate:remote:dev": "wrangler d1 migrations apply cytube-dev --remote --env dev",
    "db:studio": "node scripts/d1-studio.mjs",
    "cf-typegen": "wrangler types",
    "deploy": "astro build && wrangler deploy",
    "deploy:dev": "astro build && wrangler deploy --env dev",
    "deploy:production": "astro build && wrangler deploy --env production"
  },
  "devDependencies": {
    "prisma": "7.10.0",
    "typescript": "^5.9.2",
    "wrangler": "^4.127.1"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.5",
    "astro": "^7.2.9",
    "hono": "^4.13.5"
  }
}
