// Probe table owned by src/backend/modules/health.
generator client {
  provider            = "prisma-client"
  output              = "../src/backend/generated/prisma"
  moduleFormat        = "esm"
  runtime             = "workerd"
  importFileExtension = "js"
}

datasource db {
  provider = "sqlite"
}

model HealthCheck {
  kind      String @id
  checkedAt String @map("checked_at")

  @@map("health_checks")
}
